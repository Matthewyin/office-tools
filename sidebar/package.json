{
  "name": "office-llm-sidebar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sideload": "node scripts/sideload.js",
    "service:install": "cp com.officetools.sidebar.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.officetools.sidebar.plist",
    "service:start": "launchctl start com.officetools.sidebar",
    "service:stop": "launchctl stop com.officetools.sidebar",
    "service:restart": "launchctl stop com.officetools.sidebar && sleep 1 && launchctl start com.officetools.sidebar",
    "service:uninstall": "launchctl unload ~/Library/LaunchAgents/com.officetools.sidebar.plist && rm ~/Library/LaunchAgents/com.officetools.sidebar.plist",
    "service:log": "tail -f ~/Library/Logs/officetools-sidebar.log"
  },
  "devDependencies": {
    "office-addin-dev-certs": "^1.12.0",
    "vite": "^6.3.5"
  }
}
